"""
REAL-TIME OBJECT DETECTION AND TRACKING TOOL
Features:
- Webcam or video file input
- YOLOv8 pretrained object detection
- Persistent object tracking with IDs
- Bounding boxes, labels, and confidence scores
- Live FPS and object counter
- Save processed video
- Press Q to quit

Install:
    pip install ultralytics opencv-python
Run:
    python object_tracking.py
"""

import cv2
import time
import os
from datetime import datetime
from ultralytics import YOLO


# ---------------- CONFIGURATION ----------------

MODEL_NAME = "yolov8n.pt"  # Lightweight pretrained YOLO model
CONFIDENCE = 0.40
TRACKER_CONFIG = "bytetrack.yaml"

# Set to 0 for webcam.
# Set to a video path, e.g. "sample_video.mp4", for a video file.
VIDEO_SOURCE = 0

SAVE_OUTPUT = True
OUTPUT_FOLDER = "output_videos"


# ---------------- INITIALIZATION ----------------

def main():
    print("=" * 55)
    print("       OBJECT DETECTION & TRACKING TOOL")
    print("=" * 55)

    print("\nLoading YOLO model...")
    model = YOLO(MODEL_NAME)
    print("Model loaded successfully!")

    # Open webcam or video file
    cap = cv2.VideoCapture(VIDEO_SOURCE)

    if not cap.isOpened():
        print("Error: Could not open webcam/video.")
        print("Check your camera or VIDEO_SOURCE path.")
        return

    # Video properties
    width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH)) or 640
    height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT)) or 480
    video_fps = cap.get(cv2.CAP_PROP_FPS)

    if video_fps <= 0 or video_fps > 120:
        video_fps = 25.0

    # Prepare output writer
    writer = None

    if SAVE_OUTPUT:
        os.makedirs(OUTPUT_FOLDER, exist_ok=True)

        filename = datetime.now().strftime(
            "tracking_%Y%m%d_%H%M%S.mp4"
        )
        output_path = os.path.join(OUTPUT_FOLDER, filename)

        fourcc = cv2.VideoWriter_fourcc(*"mp4v")
        writer = cv2.VideoWriter(
            output_path,
            fourcc,
            video_fps,
            (width, height)
        )

        if not writer.isOpened():
            print("Warning: Could not create output video.")
            writer = None
        else:
            print("Output will be saved to:", output_path)

    print("\nControls:")
    print("  Q - Quit")
    print("  S - Save a screenshot")
    print("  P - Pause / Resume")
    print("\nStarting detection...\n")

    previous_time = time.time()
    fps = 0.0
    paused = False

    try:
        while cap.isOpened():

            if not paused:
                success, frame = cap.read()

                if not success:
                    print("Video ended or frame unavailable.")
                    break

                # Run object detection + tracking.
                # persist=True maintains tracking identities across frames.
                results = model.track(
                    source=frame,
                    persist=True,
                    tracker=TRACKER_CONFIG,
                    conf=CONFIDENCE,
                    verbose=False
                )

                result = results[0]

                # Draw YOLO bounding boxes and tracking labels
                annotated_frame = result.plot(
                    boxes=True,
                    labels=True,
                    conf=True
                )

                # Count detections in the current frame
                boxes = result.boxes
                object_count = len(boxes) if boxes is not None else 0

                # Count unique IDs visible in this frame
                tracked_ids = set()

                if boxes is not None and boxes.id is not None:
                    tracked_ids = {
                        int(track_id)
                        for track_id in boxes.id.cpu().tolist()
                    }

                # Calculate FPS
                current_time = time.time()
                elapsed = current_time - previous_time

                if elapsed > 0:
                    instant_fps = 1.0 / elapsed
                    fps = (
                        instant_fps if fps == 0
                        else 0.8 * fps + 0.2 * instant_fps
                    )

                previous_time = current_time

                # Add information panel
                cv2.rectangle(
                    annotated_frame,
                    (10, 10),
                    (290, 105),
                    (25, 25, 25),
                    -1
                )

                cv2.putText(
                    annotated_frame,
                    "OBJECT DETECTION & TRACKING",
                    (20, 32),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.48,
                    (255, 255, 255),
                    1
                )

                cv2.putText(
                    annotated_frame,
                    f"Objects detected: {object_count}",
                    (20, 56),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.52,
                    (0, 255, 0),
                    2
                )

                cv2.putText(
                    annotated_frame,
                    f"Tracked IDs visible: {len(tracked_ids)}",
                    (20, 78),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.48,
                    (0, 220, 255),
                    1
                )

                cv2.putText(
                    annotated_frame,
                    f"FPS: {fps:.1f}",
                    (20, 98),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.48,
                    (255, 255, 255),
                    1
                )

                # Display result
                cv2.imshow(
                    "Real-Time Object Detection & Tracking",
                    annotated_frame
                )

                # Save annotated frame
                if writer is not None:
                    writer.write(annotated_frame)

            # Keyboard controls
            key = cv2.waitKey(1 if not paused else 30) & 0xFF

            if key == ord("q"):
                break

            elif key == ord("p"):
                paused = not paused
                print("Paused" if paused else "Resumed")
                previous_time = time.time()

            elif key == ord("s") and not paused:
                screenshot_path = (
                    f"screenshot_{datetime.now():%Y%m%d_%H%M%S}.jpg"
                )
                cv2.imwrite(screenshot_path, annotated_frame)
                print("Screenshot saved:", screenshot_path)

    except KeyboardInterrupt:
        print("\nStopped by user.")

    except Exception as error:
        print("An error occurred:", error)

    finally:
        cap.release()

        if writer is not None:
            writer.release()

        cv2.destroyAllWindows()
        print("\nResources released. Tool closed.")


if __name__ == "__main__":
    main()
